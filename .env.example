# Anthropic API key for the model judges. Create one at https://console.anthropic.com/settings/keys.
# Leave empty to run rules only. `ant auth login` also works, with --models.
ANTHROPIC_API_KEY=

# GitHub token for the maintenance judge, so it is not held to 60 requests an hour.
# A fine-grained token with no permissions is enough: https://github.com/settings/tokens
GITHUB_TOKEN=

# debug | info | warn | error | silent. Logs go to stderr as JSON lines.
LOG_LEVEL=info
